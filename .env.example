# Copy to .env and fill in from the Neon Console. .env is gitignored.

# Auth → Auth Base URL. Reaches the browser.
VITE_NEON_AUTH_URL=

# Postgres database → Data API → Data API URL (ends in /rest/v1). Reaches the browser.
VITE_NEON_DATA_API_URL=

# Ordinary Postgres connection string. Used ONLY by `npm run seed`.
# No VITE_ prefix on purpose — Vite must never put this in the bundle.
DATABASE_URL=

# Optional. Set to a path such as /neon-auth to talk to Neon Auth through this
# site's own origin instead of Neon's domain. Needed because Safari discards the
# session cookie when it comes from a different domain — signing in then works
# on the server while the browser keeps nothing.
#
# vercel.json forwards that path to Neon. Leave empty to use Neon's domain
# directly, which is what everything did before and what to go back to if the
# proxy misbehaves.
VITE_NEON_AUTH_PROXY_PATH=
