{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/neon-auth/:path*",
      "destination": "https://ep-round-flower-b1717rg7.neonauth.c-5.eu-central-1.aws.neon.tech/neondb/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
